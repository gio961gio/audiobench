{
  "name": "la2a-opto-compressor-ground-truth-suite",
  "description": "Validation suite for optical dynamic range compressor against hardware modeled target",
  "thresholds": {
    "min_snr_db": 45.0,
    "max_delay_ms": 0.05
  },
  "tests": [
    {
      "id": "gt-la2a-01-drum_bus_g",
      "description": "Optical Compressor Ground Truth: drum_bus_groove (Thresh: -16.0 dBFS, Ratio: 3.0:1)",
      "expected": "ground_truth\\drum_bus_groove_gt.wav",
      "actual": "actual_renders\\drum_bus_groove_dsp.wav",
      "thresholds": {
        "min_snr_db": 50.0,
        "max_delay_ms": 0.02
      }
    },
    {
